# ==============================================================================
# PRIME by Activist - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
#
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# In production, copy this template to deployment.env and populate with cryptographically
# random secrets generated via `openssl rand -hex 32` or your enterprise secrets vault.
# ==============================================================================

# Node / Environment
NODE_ENV=production
ENVIRONMENT=production
LOG_LEVEL=info

# Domain & Routing
DOMAIN=prime.example.com
NEXT_PUBLIC_APP_NAME="PRIME by Activist"
NEXT_PUBLIC_API_URL=/api/v1

# Security & Secrets (MANDATORY: Minimum 32 cryptographically random characters)
# Generate with: openssl rand -hex 32
API_SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_HEX_SECRET_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 Enterprise Cluster)
POSTGRES_DB=prime_enterprise_production
POSTGRES_USER=prime_db_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_DB_PASSWORD_32_CHARS
DATABASE_HOST=postgres
DATABASE_PORT=5432

# In-Memory Cache (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_REDIS_PASSWORD_32_CHARS

# Bootstrap Administrator (Controlled First-Boot Seeding)
# Set ALLOW_ADMIN_BOOTSTRAP=false after initial platform installation.
ALLOW_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_EMAIL=security-admin@primebyactivist.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_INITIAL_ADMIN_PASSWORD_24_CHARS
BOOTSTRAP_ADMIN_NAME="Enterprise Platform Administrator"

# Private Storage & File Retention
STORAGE_DIR=/app/storage/uploads
MAX_FILE_SIZE_BYTES=10485760 # 10 MB Limit

