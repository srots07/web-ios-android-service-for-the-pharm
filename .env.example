# ==============================================================================
# UNIFIED PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=info
DOMAIN=unified-platform.local

# Web Application (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Unified Platform"

# Core Backend (apps/api)
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=generate-a-secure-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Central PostgreSQL Architecture
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=unified_platform
DATABASE_USER=platform_admin
DATABASE_PASSWORD=secure_platform_password
DATABASE_URL=postgresql+asyncpg://platform_admin:secure_platform_password@localhost:5432/unified_platform

# Redis (Caching & Celery Backend)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (Event System & Celery Broker)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Object Storage / S3 / MinIO
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=platform-documents
STORAGE_REGION=us-east-1

# Services Ports & Internal URLs
REPORT_SERVICE_URL=http://localhost:8001
FILE_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_URL=http://localhost:8003
INTEGRATION_SERVICE_URL=http://localhost:8004

# External Integrations (Third-party)
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
WHATSAPP_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@unified-platform.local

